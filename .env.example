# Anthropic API key. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Model selection. Defaults to the production Sonnet model.
# Use claude-haiku-4-5-20251001 for lightweight / fast paths.
AIOPS_LLM_MODEL=claude-sonnet-4-6
AIOPS_LLM_FAST_MODEL=claude-haiku-4-5-20251001

# Per-call cap. Always set explicitly — never rely on the default.
AIOPS_LLM_MAX_TOKENS=16000

# Logging level: DEBUG | INFO | WARNING | ERROR.
AIOPS_LOG_LEVEL=INFO

# Agent loop guardrail: maximum tool-call iterations per task.
AIOPS_MAX_ITERATIONS=20

# Optional integration credentials (add as integrations land).
# PAGERDUTY_API_KEY=
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
